# ─────────────────────────────────────────────────────────────────
# PANTHER — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...          # Server-only — NEVER prefix with NEXT_PUBLIC_

# ── Razorpay ──────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxx    # Public (used in frontend checkout)
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx             # Server-only

# ── Resend — Transactional email (orders, receipts) ───────────────
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxx                 # Server-only

# ── Resend SMTP — Supabase auth emails ────────────────────────────
# Used in: Supabase Dashboard → Authentication → SMTP Settings
#
# SMTP Host:     smtp.resend.com
# SMTP Port:     465 (TLS/SSL) or 587 (STARTTLS)
# Username:      resend
# Password:      <your RESEND_API_KEY value>
# Sender email:  auth@yourdomain.com  (must be a verified Resend sender domain)
# Sender name:   PANTHER
#
# ⚠️  Until you verify a custom domain in Resend, use:
#      Sender email: onboarding@resend.dev  (Resend sandbox — no verification needed)
#
# Steps:
#   1. Resend Dashboard → Domains → Add Domain → verify yourdomain.com DNS
#   2. Create API key with "Sending Access" scope
#   3. Fill in Supabase SMTP settings above
#   4. Set AUTH_EMAIL_FROM below to match the verified sender address
#   5. In Supabase → Auth → Email Templates → Magic Link: paste supabase/email-templates/magic-link.html
#
# No env var is needed here — this is configured directly in Supabase Dashboard.
# AUTH_EMAIL_FROM is used only for reference / documentation.
AUTH_EMAIL_FROM=PANTHER <auth@yourdomain.com>   # Must match verified Resend sender

# ── Email sender addresses ────────────────────────────────────────
# Transactional (orders, receipts) — sent via RESEND_API_KEY above
EMAIL_FROM=PANTHER <orders@yourdomain.com>      # Defaults to onboarding@resend.dev in sandbox

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_URL=https://yourdomain.com

# ── Firebase Admin SDK (FCM Push Notifications) ───────────────────
# Minified single-line JSON string of your Firebase service account key.
# Get this from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'

# ── Future: mail domain separation (add when ready) ───────────────
# EMAIL_MARKETING_FROM=PANTHER <hello@yourdomain.com>
# EMAIL_SUPPORT_FROM=PANTHER <support@yourdomain.com>
# EMAIL_AUTH_FROM=PANTHER <auth@yourdomain.com>

