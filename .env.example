# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...          # Server-only — NEVER prefix with NEXT_PUBLIC_

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxx    # Public (used in frontend checkout)
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx             # Server-only

# Resend (Email)
RESEND_API_KEY=re_xxxxxxxxxx                 # Server-only

# App
NEXT_PUBLIC_URL=https://yourdomain.com
EMAIL_FROM=NOIR <orders@yourdomain.com>      # Optional — defaults to Resend sandbox
